<?xml version="1.0" encoding="UTF-8"?>
<svg width="600" height="400" viewBox="0 0 600 400" xmlns="http://www.w3.org/2000/svg">
  <!-- 背景 -->
  <rect width="600" height="400" fill="#F7DF1E" />
  
  <!-- 中央大JS标志 -->
  <rect x="150" y="100" width="300" height="200" rx="10" fill="#323330" />
  <text x="300" y="225" font-family="Arial, sans-serif" font-size="90" font-weight="bold" fill="#F7DF1E" text-anchor="middle">JS</text>
  
  <!-- 右上角符号 -->
  <text x="420" y="160" font-family="Courier New, monospace" font-size="40" fill="#323330" text-anchor="middle">{ }</text>
  
  <!-- 左下角符号 -->
  <text x="180" y="260" font-family="Courier New, monospace" font-size="40" fill="#323330" text-anchor="middle">( )</text>
  
  <!-- 标题 -->
  <text x="300" y="60" font-family="Arial, sans-serif" font-size="36" font-weight="bold" fill="#323330" text-anchor="middle">JavaScript编程</text>
  
  <!-- 底部文本 -->
  <text x="300" y="350" font-family="Arial, sans-serif" font-size="24" fill="#323330" text-anchor="middle">从基础到高级的学习体验</text>
</svg> 