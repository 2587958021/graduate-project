<?xml version="1.0" encoding="UTF-8"?>
<svg width="600" height="400" viewBox="0 0 600 400" xmlns="http://www.w3.org/2000/svg">
  <!-- 背景 -->
  <rect width="600" height="400" fill="#35495E" />
  
  <!-- Vue Logo -->
  <polygon points="300,130 340,195 380,130" fill="#41B883" />
  <polygon points="300,130 260,195 220,130" fill="#41B883" />
  <polygon points="300,130 340,195 300,260 260,195" fill="#41B883" />
  <polygon points="180,130 220,130 300,260 380,130 420,130 300,340" fill="#34495E" />
  <polygon points="180,130 220,130 300,260 380,130 420,130 300,340" fill="#41B883" opacity="0.5" />
  
  <!-- 标题 -->
  <text x="300" y="60" font-family="Arial, sans-serif" font-size="36" font-weight="bold" fill="white" text-anchor="middle">Vue.js 框架开发</text>
  
  <!-- 装饰元素 -->
  <circle cx="150" cy="280" r="20" fill="#41B883" opacity="0.7" />
  <circle cx="450" cy="280" r="20" fill="#41B883" opacity="0.7" />
  
  <!-- 底部文本 -->
  <text x="300" y="350" font-family="Arial, sans-serif" font-size="24" fill="white" text-anchor="middle">构建现代化的交互式前端应用</text>
</svg> 